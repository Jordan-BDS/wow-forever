# Copier en deploy/.env sur le VPS et remplir. Ne jamais versionner le .env.

# --- Domaine et base --------------------------------------------------------
# Domaine servi par Caddy avec HTTPS automatique. Derrière un nginx hôte, ne pas le renseigner.
SITE_DOMAIN=guilde.example.org
POSTGRES_DB=wow
POSTGRES_USER=wow
POSTGRES_PASSWORD=change-moi

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-moi-aussi
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=guilde.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://guilde.example.org
SITE_URL=https://guilde.example.org
# FRONTEND_URL vaut SITE_URL par défaut (même origine).

# --- Discord (https://discord.com/developers/applications) -----------------
# Tout ceci se renseigne aussi (et de préférence) sur le site, dans Guilde › Paramètres, une fois le premier GM
# connecté. Les valeurs ci-dessous ne servent que de secours quand le site n'a rien enregistré.
# OAuth2 : ajouter https://guilde.example.org/api/auth/discord/callback/ dans les « Redirects ».
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot : onglet « Bot », bouton « Reset Token », et activer l'intent privilégié « Server Members Intent ».
# Inviter le bot sur le serveur avec les scopes `bot` + `applications.commands` et les permissions
# « Envoyer des messages » et « Voir les salons » (pour publier dans le salon des annonces).
DISCORD_BOT_TOKEN=
# Clic droit sur le serveur → « Copier l'identifiant » (mode développeur activé).
DISCORD_GUILD_ID=
# IDs des rôles Discord autorisés à se connecter, séparés par des virgules.
DISCORD_ALLOWED_ROLE_IDS=
# ID Discord du premier GM (promu automatiquement à sa connexion).
DISCORD_FIRST_GM_ID=

# --- API Battle.net (https://develop.battle.net/access/clients) -------------
# Client « Server » sans URL de redirection : jeton d'application, suffisant pour lire personnages et guilde.
# Sonde : make blizzard-probe CHAR=prenom-nom ; lecture de tout le monde : make blizzard-import.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
# Version du client pour les données statiques (classes, objets), ex. 1.60.1_70399 ; vide tant qu'inutile.
BLIZZARD_STATIC_VERSION=
